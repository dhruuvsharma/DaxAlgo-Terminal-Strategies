<?xml version="1.0" encoding="utf-8"?>
<!-- The strategies build against the published DaxAlgo SDK packages (DaxAlgo.Sdk / DaxAlgo.Sdk.Wpf)
     on nuget.org. Pinned explicitly so a machine with extra/broken feeds still restores. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
